{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beta-arsenal-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arsenal-db-prod",
      "database_id": "969f85c2-1e05-48e0-b438-728e24aae71e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FRONT_ORIGINS": "https://arsenal-tools.pages.dev,https://arsenal-v3-preview.pages.dev",
    "GITHUB_REPO_OWNER": "odin10032-rgb",
    "GITHUB_REPO_NAME": "arsenal-produits",
    "GITHUB_BRANCH": "main"
  },
  "observability": {
    "enabled": true
  }
}
